{
  "id": "resourcegroup",
  "name": "Azure Resource Group",
  "description": "One resource group, from the terraform-modules-examples repo. Needs Azure credentials as ARM_* env variables (e.g. a variable set).",
  "module": {
    "source": "git::https://github.com/Opsolete/terraform-modules-examples.git//resourcegroup",
    "ref": "v1.0.0"
  },
  "inputs": [
    { "name": "name", "label": "Resource group name", "type": "string", "required": true, "pattern": "^[A-Za-z0-9_().-]{0,89}[A-Za-z0-9_()-]$" },
    { "name": "location", "label": "Region", "type": "select", "required": true, "options": ["westeurope", "northeurope"], "default": "westeurope" }
  ]
}
